            box-shadow: 0 15px 35px rgba(15, 23, 42, 0.12);
            border: 1px solid var(--border);
          }
          h1 { margin: 0 0 12px; }
          p { color: var(--muted); line-height: 1.6; }
          form { display: flex; flex-direction: column; gap: 18px; margin-top: 24px; }
          label { display: flex; flex-direction: column; gap: 8px; font-weight: 700; }
          input {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 16px;
          }
          button {
            border: none;
            background: var(--primary);
            color: white;
            border-radius: 10px;
            padding: 12px 18px;
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
          }
          button:hover { background: var(--primary-dark); }
          .result {
            margin-top: 24px;
            padding: 18px;
            border-radius: 12px;
            background: #f8fafc;
            border: 1px solid #dbeafe;
          }
          .status-tag {
            display: inline-block;
            margin-top: 12px;
            padding: 6px 10px;
            border-radius: 999px;
            background: #dbeafe;
            color: #1d4ed8;
            font-weight: 700;
          }
        </style>
      </head>
      <body>
        <div class="card">
          <div style="font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:#475569;">Takip</div>
          <h1>Sipariş Durumunu Kontrol Et</h1>
          <p>SMS ile gelen linkten sipariş kodunu girerek durumu öğrenebilirsiniz.</p>

          <form id="trackingForm">
            <label>
              Sipariş Kodu
              <input type="text" id="orderCode" placeholder="Örn: ORD-12345678" required />
            </label>
            <button type="submit">Durumu Göster</button>
          </form>

          <div id="resultBox" class="result" style="display:none;"></div>
        </div>

        <script>
          const form = document.getElementById('trackingForm');
          const codeInput = document.getElementById('orderCode');
          const resultBox = document.getElementById('resultBox');

          const urlParams = new URLSearchParams(window.location.search);
          const prefilled = urlParams.get('code');
          if (prefilled) {
            codeInput.value = prefilled;
          }

          form.addEventListener('submit', async (e) => {
            e.preventDefault();

            const code = codeInput.value.trim();
            if (!code) {
              resultBox.style.display = 'block';
              resultBox.innerHTML = '<p>Lütfen sipariş kodunu girin.</p>';
              resultBox.style.background = '#fff1f2';
              resultBox.style.borderColor = '#fecaca';
              return;
            }

            try {
              const res = await fetch(`/api/track?code=${encodeURIComponent(code)}`);
              const data = await res.json();

              if (!res.ok || !data.success) {
                throw new Error(data.message || 'Sipariş bulunamadı.');
              }

              const d = data.data;
              resultBox.style.display = 'block';
              resultBox.innerHTML = `
                <h3>Sipariş Bilgisi</h3>
                <p><strong>Sipariş Kodu:</strong> ${d.orderCode}</p>
                <p><strong>Müşteri Telefonu:</strong> ${d.customerPhone}</p>
                <p><strong>Teslim Adresi:</strong> ${d.shippingAddress}</p>
                <p><strong>Sipariş Notu:</strong> ${d.orderDetails || 'Belirtilmemiş'}</p>
                <div class="status-tag">${d.statusLabel}</div>
              `;
            } catch (error) {
              resultBox.style.display = 'block';
              resultBox.innerHTML = `<p>${error.message}</p>`;
              resultBox.style.background = '#fff1f2';
              resultBox.style.borderColor = '#fecaca';
            }
          });
        </script>
      </body>
    </html>
  `;
}

app.get('/admin', (req, res) => res.send(renderAdminPage()));
app.get('/track', (req, res) => res.send(renderTrackPage()));

app.get('/', (req, res) => {
  res.redirect('/admin');
});

(async () => {
  try {
    await initDb();
    console.log('Database initialized.');
  } catch (error) {
    console.warn('Database init warning:', error.message);
  }

  app.listen(port, () => {
    console.log(`Server running on http://localhost:${port}`);
    console.log(`Admin: http://localhost:${port}/admin`);
    console.log(`Tracking: http://localhost:${port}/track`);
  });
})();
