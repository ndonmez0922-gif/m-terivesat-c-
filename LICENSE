function renderTrackPage() {
  return `
    <!DOCTYPE html>
    <html lang="tr">
      <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Sipariş Takip</title>
        <style>
          :root {
            --bg1: #eff6ff;
            --bg2: #e0f2fe;
            --card: #fff;
            --primary: #0ea5e9;
            --primary-dark: #0284c7;
            --text: #0f172a;
            --muted: #475569;
            --border: #dfe7f1;
          }
          * { box-sizing: border-box; }
          body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, var(--bg1), var(--bg2));
            color: var(--text);
          }
          .card {
            width: min(100%, 600px);
            background: var(--card);
            border-radius: 18px;
