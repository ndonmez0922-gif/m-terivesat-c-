          const STATUS_OPTIONS = {
            siparis_alindi: 'Sipariş Alındı',
            hazirlaniyor: 'Hazırlanıyor',
            yola_cikti: 'Yola Çıktı',
            teslim_edildi: 'Teslim Edildi'
          };

          async function fetchJson(url, options = {}) {
            const response = await fetch(url, {
              headers: { 'Content-Type': 'application/json', ...(options.headers || {}) },
              ...options
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.message || 'İşlem başarısız.');
            return data;
          }

          async function loadCustomers() {
            const res = await fetchJson('/api/customers');
            const rows = res.data.map(customer => `
              <tr>
                <td>${customer.id}</td>
                <td>${customer.name}</td>
                <td>${customer.phone}</td>
                <td>${customer.email || '-'}</td>
              </tr>
            `).join('');

            document.getElementById('customerTable').innerHTML = `
              <table>
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Ad Soyad</th>
                    <th>Telefon</th>
                    <th>E-posta</th>
                  </tr>
                </thead>
                <tbody>${rows || '<tr><td colspan=\"4\">Müşteri bulunamadı.</td></tr>'}</tbody>
              </table>
            `;
          }

          async function loadOrders() {
            const res = await fetchJson('/api/orders');
            const rows = res.data.map(order => `
              <tr>
                <td>${order.order_code}</td>
                <td>${order.customer_name}</td>
                <td>${order.customer_phone}</td>
                <td>${STATUS_OPTIONS[order.status] || order.status}</td>
                <td>
                  <select class="status-select" data-id="${order.id}">
                    ${Object.entries(STATUS_OPTIONS).map(([value, label]) => `
                      <option value="${value}" ${value === order.status ? 'selected' : ''}>${label}</option>
                    `).join('')}
                  </select>
                </td>
                <td><a href="${order.tracking_link}" target="_blank">Takip Linki</a></td>
              </tr>
            `).join('');

            document.getElementById('orderTable').innerHTML = `
              <table>
                <thead>
                  <tr>
                    <th>Sipariş Kodu</th>
                    <th>Müşteri</th>
                    <th>Telefon</th>
                    <th>Durum</th>
                    <th>Durum Güncelle</th>
                    <th>Takip Linki</th>
                  </tr>
                </thead>
                <tbody>${rows || '<tr><td colspan=\"6\">Sipariş bulunamadı.</td></tr>'}</tbody>
              </table>
            `;

            document.querySelectorAll('.status-select').forEach(select => {
              select.addEventListener('change', async (e) => {
                const id = e.target.dataset.id;
                const status = e.target.value;

                try {
                  await fetchJson(`/api/orders/${id}/status`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                  });
                  alert('Sipariş durumu güncellendi.');
                  loadOrders();
                } catch (error) {
                  alert(error.message);
                }
              });
            });
          }

          document.getElementById('customerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const payload = {
              name: document.getElementById('customerName').value.trim(),
              phone: document.getElementById('customerPhone').value.trim(),
              email: document.getElementById('customerEmail').value.trim()
