SMS_API_SENDER=ORDERTR
SMS_API_URL=https://api.netgsm.com.tr/sms/send
const express = require('express');
const cors = require('cors');
const dotenv = require('dotenv');
const { Pool } = require('pg');

dotenv.config();
const app = express();
const port = process.env.PORT || 3000;

// PostgreSQL connection
const pool = new Pool({
  host: process.env.DB_HOST || 'localhost',
  port: Number(process.env.DB_PORT || 5432),
  database: process.env.DB_NAME || 'order_tracking_db',
  user: process.env.DB_USER || 'postgres',
  password: process.env.DB_PASSWORD || 'postgres',
  max: 10,
  idleTimeoutMillis: 30000,
  connectionTimeoutMillis: 5000
});

async function initDb() {
  const schema = `
    CREATE TABLE IF NOT EXISTS customers (
      id SERIAL PRIMARY KEY,
      name VARCHAR(150) NOT NULL,
      phone VARCHAR(25) NOT NULL UNIQUE,
      email VARCHAR(150),
      created_at TIMESTAMP DEFAULT NOW()
    );

    CREATE TABLE IF NOT EXISTS orders (
      id SERIAL PRIMARY KEY,
      order_code VARCHAR(50) NOT NULL UNIQUE,
      customer_id INT REFERENCES customers(id) ON DELETE CASCADE,
      customer_name VARCHAR(150) NOT NULL,
      customer_phone VARCHAR(25) NOT NULL,
      shipping_address TEXT NOT NULL,
      order_details TEXT,
      total_amount NUMERIC(10,2) DEFAULT 0,
      status VARCHAR(30) NOT NULL DEFAULT 'siparis_alindi',
      tracking_link TEXT NOT NULL,
      created_at TIMESTAMP DEFAULT NOW(),
      updated_at TIMESTAMP DEFAULT NOW()
    );

    CREATE TABLE IF NOT EXISTS sms_logs (
      id SERIAL PRIMARY KEY,
      order_id INT REFERENCES orders(id) ON DELETE CASCADE,
      customer_phone VARCHAR(25) NOT NULL,
      message TEXT NOT NULL,
      provider VARCHAR(50) DEFAULT 'netgsm',
      status VARCHAR(20) NOT NULL DEFAULT 'sent',
      created_at TIMESTAMP DEFAULT NOW()
    );

    CREATE INDEX IF NOT EXISTS idx_orders_status ON orders(status);
    CREATE INDEX IF NOT EXISTS idx_orders_code ON orders(order_code);
    CREATE INDEX IF NOT EXISTS idx_customers_phone ON customers(phone);
  `;

  const statements = schema
    .split(';')
    .map(s => s.trim())
    .filter(Boolean);

  for (const statement of statements) {
    await pool.query(statement);
  }
}

function normalizePhone(phone) {
  if (!phone) return '';
  return String(phone).replace(/\\s+/g, '').replace(/[^0-9+]/g, '');
}

const STATUS_LABELS = {
  siparis_alindi: 'Sipariş Alındı',
  hazirlaniyor: 'Hazırlanıyor',
  yola_cikti: 'Yola Çıktı',
  teslim_edildi: 'Teslim Edildi'
};

const STATUS_MESSAGES = {
  siparis_alindi: 'Siparişiniz alındı.',
  hazirlaniyor: 'Siparişiniz hazırlanıyor.',
  yola_cikti: 'Siparişiniz yola çıktı.',
  teslim_edildi: 'Siparişiniz teslim edildi.'
};

async function sendSms({ phone, message }) {
  const provider = process.env.SMS_PROVIDER || 'netgsm';
  const username = process.env.SMS_API_USERNAME;
  const password = process.env.SMS_API_PASSWORD;
  const sender = process.env.SMS_API_SENDER || 'ORDERTR';
  const apiUrl = process.env.SMS_API_URL || '';

  const cleanPhone = normalizePhone(phone);

  if (!cleanPhone) {
    return { success: false, simulated: false, message: 'Telefon numarası geçersiz.' };
  }

  if (!apiUrl || !username || !password) {
    return {
      success: true,
      simulated: true,
      provider,
      message: 'SMS sağlayıcısı yapılandırılmadı; simülasyon modu aktif.'
    };
  }

  try {
    const payload = new URLSearchParams({
      username,
      password,
      sender,
      gsm: cleanPhone,
      message
    });

    const response = await fetch(apiUrl, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/x-www-form-urlencoded'
      },
      body: payload.toString()
    });

    const raw = await response.text();

    return {
      success: response.ok,
      simulated: false,
      provider,
      raw
    };
  } catch (error) {
    return {
      success: false,
      simulated: false,
      provider,
      message: error.message
    };
  }
}

async function sendStatusSms(order) {
  const statusKey = order.status || 'siparis_alindi';
  const statusText = STATUS_MESSAGES[statusKey] || 'Siparişiniz güncellendi.';
  const message = `${statusText} Sipariş Kodu: ${order.order_code}. Takip Linki: ${order.tracking_link}`;

  return await sendSms({
    phone: order.customer_phone,
    message
  });
}

async function ensureCustomer({ name, phone, email }) {
  const cleanPhone = normalizePhone(phone);

  if (!cleanPhone) {
    throw new Error('Telefon numarası gerekli.');
  }

  const existing = await pool.query(
    'SELECT * FROM customers WHERE phone = $1 LIMIT 1',
    [cleanPhone]
  );

  if (existing.rows.length > 0) {
    return existing.rows[0];
  }

  const result = await pool.query(
    `INSERT INTO customers (name, phone, email)
     VALUES ($1, $2, $3)
     RETURNING *`,
    [name || 'Müşteri', cleanPhone, email || null]
  );

  return result.rows[0];
}

app.use(cors());
app.use(express.json({ limit: '2mb' }));
app.use(express.urlencoded({ extended: true }));

app.get('/health', async (req, res) => {
  try {
    await pool.query('SELECT 1');
    res.json({ ok: true, database: 'connected' });
  } catch (error) {
    res.json({ ok: false, database: 'disconnected' });
  }
});

app.get('/api/customers', async (req, res) => {
  try {
    const result = await pool.query('SELECT * FROM customers ORDER BY created_at DESC');
    res.json({ success: true, data: result.rows });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message });
  }
});

app.get('/api/orders', async (req, res) => {
  try {
    const result = await pool.query(`
      SELECT o.*, c.name AS customer_name_full, c.email
      FROM orders o
      LEFT JOIN customers c ON c.id = o.customer_id
      ORDER BY o.created_at DESC
    `);
    res.json({ success: true, data: result.rows });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message });
  }
});

app.post('/api/customers', async (req, res) => {
  try {
    const { name, phone, email } = req.body;

    if (!name || !normalizePhone(phone)) {
      return res.status(400).json({ success: false, message: 'Ad ve telefon zorunludur.' });
    }

    const customer = await ensureCustomer({ name, phone, email });
    res.status(201).json({ success: true, data: customer });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message || 'Müşteri eklenemedi.' });
  }
});

app.post('/api/orders', async (req, res) => {
  try {
    const {
      customerName,
      customerPhone,
      shippingAddress,
      orderDetails,
      totalAmount,
      sendSms = true
    } = req.body;

    if (!customerName || !normalizePhone(customerPhone) || !shippingAddress) {
      return res.status(400).json({
        success: false,
        message: 'Müşteri adı, telefon ve teslim adresi zorunludur.'
      });
    }

    const customer = await ensureCustomer({
      name: customerName,
      phone: customerPhone,
      email: req.body.email || null
    });

    const orderCode = `ORD-${Date.now().toString().slice(-8)}`;
    const baseUrl = process.env.CLIENT_TRACKING_URL || 'http://localhost:3000/track';
    const trackingLink = `${baseUrl}?code=${orderCode}`;

    const result = await pool.query(`
      INSERT INTO orders (
        order_code,
        customer_id,
        customer_name,
        customer_phone,
        shipping_address,
        order_details,
        total_amount,
        status,
        tracking_link
      )
      VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9)
      RETURNING *
    `, [
      orderCode,
      customer.id,
      customerName,
      normalizePhone(customerPhone),
      shippingAddress,
      orderDetails || '',
      Number(totalAmount) || 0,
      'siparis_alindi',
      trackingLink
    ]);

    const order = result.rows[0];

    if (sendSms) {
      await sendStatusSms(order);
    }

    res.status(201).json({ success: true, data: order });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message || 'Sipariş oluşturulamadı.' });
  }
});

app.put('/api/orders/:id/status', async (req, res) => {
  try {
    const { id } = req.params;
    const { status } = req.body;

    if (!status || !STATUS_LABELS[status]) {
      return res.status(400).json({ success: false, message: 'Geçersiz sipariş durumu.' });
    }

    const result = await pool.query(`
      UPDATE orders
      SET status = $1, updated_at = NOW()
      WHERE id = $2
      RETURNING *
    `, [status, id]);

    if (result.rows.length === 0) {
      return res.status(404).json({ success: false, message: 'Sipariş bulunamadı.' });
    }

    const updatedOrder = result.rows[0];
    await sendStatusSms(updatedOrder);

    res.json({ success: true, data: updatedOrder });
  } catch (error) {
    res.status(500).json({ success: false, message: error.message || 'Durum güncellenemedi.' });
  }
});

app.get('/api/track', async (req, res) => {
  try {
    const { code } = req.query;

    if (!code) {
      return res.status(400).json({ success: false, message: 'Sipariş kodu gerekli.' });
    }

    const result = await pool.query(
      `SELECT * FROM orders WHERE order_code = $1 LIMIT 1`,
      [String(code).trim()]
    );

    if (result.rows.length === 0) {
      return res.status(404).json({ success: false, message: 'Sipariş bulunamadı.' });
    }

    const order = result.rows[0];

    res.json({
      success: true,
      data: {
        orderCode: order.order_code,
        customerPhone: order.customer_phone,
        shippingAddress: order.shipping_address,
        orderDetails: order.order_details || '',
        status: order.status,
        statusLabel: STATUS_LABELS[order.status] || order.status,
        trackingLink: order.tracking_link
      }
    });
  } catch (error) {
    res.status(500).json({ success: false, message: 'Durum sorgulanırken hata oluştu.' });
  }
});

